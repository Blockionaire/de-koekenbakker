/* =====================================================================
   DE KOEKENBAKKER — beveiligingsregels voor Firestore
   =====================================================================
   Dit bestand is de échte beveiliging. Alles wat de webshop en de portal
   zelf controleren is vriendelijkheid richting de gebruiker; wat hier
   staat draait bij Google en is niet te omzeilen.

   Zo zet je ze aan:
     Firebase Console → Firestore Database → Rules → alles hieronder
     erin plakken → Publish.

   In bakkerMails() hieronder staat het adres waarmee Zara in de portal
   inlogt. Wil je er iemand bij (bijvoorbeeld om mee te kijken), zet het
   adres er dan bij in de lijst en publiceer de regels opnieuw.

   De afspraak in het kort:

     - Iedereen mag een bestelling plaatsen, maar er verder niets mee:
       niet lezen, niet wijzigen, niet verwijderen. Een klant kan dus
       nooit zien wat een ander besteld heeft.
     - Jij mag zelf ook bestellingen toevoegen en bewerken in de portal,
       bijvoorbeeld voor wat er mondeling of via Instagram binnenkomt.
     - Een bestelling moet er ook uitzien als een bestelling: een naam,
       een contactgegeven, hooguit 40 koekjes en status "nieuw".
     - Bij elke bestelling hoort een los standje op bestelnummer, zodat
       een klant met zijn eigen nummer kan zien waar zijn koekjes zijn.
       Daar staat alleen de stap in waar hij is, plus een voornaam om
       iemand gedag te kunnen zeggen — geen achternaam, geen contact.
     - Reacties van klanten mag iedereen insturen, maar ze staan pas op
       de site als jij ze in de portal goedkeurt. Tot die tijd kan
       niemand ze lezen behalve jij.
     - In de winkel staat welke koekjes te koop zijn. Dat mag iedereen
       lezen (de website heeft het nodig), maar alleen jij kunt een
       koekje aan of uit zetten.
     - Per dag staat er een rijtje turven: hoe vaak de site geopend is,
       hoe vaak er besteld is, en waar bezoekers vandaan kwamen. Daar
       staat niets persoonlijks in, en lezen mag alleen jij.
     - Het weekoverzicht (hoeveel er al besteld is) mag iedereen lezen —
       de webshop heeft dat nodig om te weten of de week nog ruimte
       heeft. Wijzigen mag alleen in één richting: het aantal omhoog,
       met hooguit 40 tegelijk.
     - Jij, met het adres hieronder, mag alles.
   ===================================================================== */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------
       Wie is de bakker? Vul hier je eigen e-mailadres in.
       Meerdere mag: return ['zara@voorbeeld.nl', 'mama@voorbeeld.nl'];
       --------------------------------------------------------------- */
    function bakkerMails() {
      return ['zaraprins08@gmail.com', 'joostprins2001@gmail.com'];
    }

    function isBakker() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in bakkerMails();
    }

    /* ---------------------------------------------------------------
       De bestellingen
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/bestellingen/{bestelling} {

      function geldigeBestelling() {
        let d = request.resource.data;
        return d.keys().hasOnly(['code', 'week', 'status', 'gemaakt', 'naam', 'contact',
                                 'notitie', 'levering', 'moment', 'adres', 'regels',
                                 'koekjes', 'bedrag'])
          && d.status == 'nieuw'
          && d.naam is string && d.naam.size() > 0 && d.naam.size() <= 120
          && d.contact is string && d.contact.size() > 0 && d.contact.size() <= 120
          && d.week is string && d.week.size() <= 10
          && d.code is string && d.code.size() <= 8
          && d.levering in ['Afhalen', 'Bezorgen']
          && d.moment is string && d.moment.size() <= 120
          && d.adres is string && d.adres.size() <= 200
          && d.notitie is string && d.notitie.size() <= 600
          && d.regels is list && d.regels.size() <= 40
          && d.koekjes is int && d.koekjes > 0 && d.koekjes <= 40
          && d.bedrag is number && d.bedrag >= 0 && d.bedrag <= 2000;
      }

      /* Een klant mag bestellen, en wel precies zoals hierboven beschreven.
         De bakker mag zelf ook een bestelling aanmaken — bijvoorbeeld eentje
         die mondeling of via Instagram binnenkwam — en is daarbij niet aan
         die vorm gebonden. */
      allow create: if geldigeBestelling() || isBakker();

      /* Lezen, bijwerken en weggooien is alleen voor de bakker. */
      allow read, update, delete: if isBakker();
    }

    /* ---------------------------------------------------------------
       De stand van een bestelling, op bestelnummer

       Hier staat alleen in hoe ver een bestelling is, plus een voornaam
       om iemand gedag te zeggen — geen achternaam, geen telefoonnummer,
       geen adres. Dat is met opzet: de website laat een klant met zijn
       eigen nummer zien waar zijn koekjes zijn, en wie een nummer raadt
       komt niet verder dan een voornaam en een stap. Aanmaken mag de webshop
       (alleen als "nieuw", en alleen als het nummer nog vrij is);
       veranderen en weggooien mag alleen jij.
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/status/{nummer} {

      function geldigeStand() {
        let d = request.resource.data;
        return d.keys().hasOnly(['code', 'week', 'status', 'koekjes', 'moment', 'voornaam', 'bijgewerkt'])
          && d.status == 'nieuw'
          && d.code is string && d.code.size() > 0 && d.code.size() <= 8
          && d.week is string && d.week.size() <= 10
          && d.koekjes is int && d.koekjes > 0 && d.koekjes <= 40
          && d.moment is string && d.moment.size() <= 120
          && (!('voornaam' in d) || (d.voornaam is string && d.voornaam.size() <= 40));
      }

      allow read: if true;
      allow create: if geldigeStand() || isBakker();
      allow update, delete: if isBakker();
    }

    /* ---------------------------------------------------------------
       Het weekoverzicht: hoeveel er deze week besteld is
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/weken/{week} {

      /* De webshop moet dit kunnen lezen om te weten of de week vol is.
         Er staan alleen aantallen in, geen klantgegevens. */
      allow read: if true;

      /* De eerste bestelling van een week maakt het overzicht aan. */
      allow create: if request.resource.data.keys().hasOnly(['besteld', 'limiet', 'open'])
        && request.resource.data.besteld is int
        && request.resource.data.besteld > 0
        && request.resource.data.besteld <= 40
        && request.resource.data.limiet is int
        && request.resource.data.limiet >= 0
        && request.resource.data.limiet <= 2000
        && request.resource.data.open == true;

      /* Daarna mag een bestelling alleen de teller ophogen — nooit het
         limiet veranderen, nooit de teller omlaag. */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['besteld'])
        && request.resource.data.besteld is int
        && request.resource.data.besteld > resource.data.besteld
        && request.resource.data.besteld <= resource.data.besteld + 40;

      /* De bakker mag alles: limiet zetten, week sluiten, teller
         corrigeren, en bij een annulering de teller omlaag. */
      allow write: if isBakker();
    }

    /* ---------------------------------------------------------------
       De turven: hoe druk was het op een dag

       Per dag één rijtje getallen. Er staat niets persoonlijks in: geen
       namen, geen IP-adressen, geen nummers waarmee je iemand over
       websites heen kunt volgen. Alleen hoe vaak de site geopend is, hoe
       vaak er een mandje openging, hoe vaak er besteld is, en waar
       bezoekers vandaan kwamen.

       Lezen mag alleen jij. Een bezoeker mag alleen turven: elk getal
       blijft gelijk of gaat precies één omhoog, nooit omlaag en nooit met
       sprongen. Zo kan niemand de cijfers opblazen of wissen.
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/bezoek/{dag} {

      function velden() {
        return ['bezoeken', 'sessies', 'mobiel', 'mandje', 'besteld', 'volg',
                'direct', 'instagram', 'whatsapp', 'google', 'tiktok', 'anders'];
      }

      /* Een nieuwe dag begint bij nul of één. */
      function nieuweDag() {
        let d = request.resource.data;
        return d.keys().hasOnly(velden())
          && d.values().hasOnly([0, 1]);
      }

      /* Daarna mag elk getal alleen gelijk blijven of één omhoog. */
      function eenOmhoog(k) {
        let d = request.resource.data;
        let o = resource.data;
        return !(k in d) || d[k] == (k in o ? o[k] : 0) || d[k] == (k in o ? o[k] : 0) + 1;
      }

      function netjesGeturfd() {
        return request.resource.data.keys().hasOnly(velden())
          && eenOmhoog('bezoeken') && eenOmhoog('sessies') && eenOmhoog('mobiel')
          && eenOmhoog('mandje') && eenOmhoog('besteld') && eenOmhoog('volg')
          && eenOmhoog('direct') && eenOmhoog('instagram') && eenOmhoog('whatsapp')
          && eenOmhoog('google') && eenOmhoog('tiktok') && eenOmhoog('anders');
      }

      allow read: if isBakker();
      allow create: if nieuweDag() || isBakker();
      allow update: if netjesGeturfd() || isBakker();
      allow delete: if isBakker();
    }

    /* ---------------------------------------------------------------
       Reacties van klanten

       Iedereen mag er een achterlaten, maar niemand ziet hem meteen.
       Een nieuwe reactie moet binnenkomen met goedgekeurd op false, en
       alleen jij kunt dat op true zetten. De website vraagt dus alleen
       om de goedgekeurde reacties, en meer krijgt hij ook niet.

       Wat erin mag staan ligt vast: een reactie, een naam, of de naam
       erbij mag, welke koekjes het waren, hoeveel sterren, en eventueel
       het bestelnummer dat de site zelf al onthouden had. Alles is
       begrensd, zodat niemand er een heel boek in kwijt kan.
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/recensies/{reactie} {

      function nieuweReactie() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tekst', 'naam', 'naamTonen', 'smaken', 'sterren',
                                 'bestelling', 'gemaakt', 'goedgekeurd', 'behandeld'])
          && d.keys().hasAll(['tekst', 'naamTonen', 'sterren', 'goedgekeurd', 'behandeld'])
          && d.goedgekeurd == false
          && d.behandeld == false
          && d.tekst is string && d.tekst.size() >= 5 && d.tekst.size() <= 400
          && (!('naam' in d) || (d.naam is string && d.naam.size() <= 60))
          && d.naamTonen is bool
          && (!('smaken' in d) || (d.smaken is list && d.smaken.size() <= 8))
          && d.sterren is int && d.sterren >= 1 && d.sterren <= 5
          && (!('bestelling' in d) || (d.bestelling is string && d.bestelling.size() <= 8))
          && (!('gemaakt' in d) || d.gemaakt == request.time);
      }

      /* Lezen mag iedereen, maar alleen wat jij hebt goedgekeurd. */
      allow read: if isBakker() || resource.data.goedgekeurd == true;
      allow create: if nieuweReactie() || isBakker();
      allow update, delete: if isBakker();
    }

    /* ---------------------------------------------------------------
       De winkel: welke koekjes te koop zijn

       Een documentje met per koekje of het aan of uit staat, en waarom.
       Iedereen mag het lezen, want de website heeft het nodig om een
       uitverkocht koekje grijs te zetten. Aanpassen mag alleen jij.
       --------------------------------------------------------------- */
    match /koekenbakker/{ruimte}/winkel/{wat} {
      allow read: if true;
      allow write: if isBakker();
    }

    /* Alles wat hier niet staat, mag niet. */
  }
}
